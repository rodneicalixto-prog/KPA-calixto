# Kit Piloto Automatico V30 — template de ambiente local
# Copie para .env e preencha. NUNCA commite o .env real (ele ja esta no .gitignore).
# Vazou um token? Revoga no provider imediatamente (Meta Business Manager, Composio, Slack, etc).

# --- Identificacao do operador (nao-sensivel) ---
OPERATOR_NAME=
OPERATOR_BRAND=

# --- Composio (Drive, Slack, Notion, Gmail, HubSpot, Linear, X/LinkedIn) ---
# O connector nativo do Claude usa OAuth e guarda a credencial no provedor;
# nao e necessario nem permitido copiar token para este arquivo.

# --- WhatsApp MCP (opcional, se atende/vende por WhatsApp) ---
WHATSAPP_SESSION_NAME=

# --- Slack (se aplicavel) ---
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# --- GitHub (se aplicavel) ---
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Firecrawl (se aplicavel, pesquisa/scraping) ---
FIRECRAWL_API_KEY=

# --- Meta Ads CLI (opcional, so quem roda trafego pago) ---
# Preenchido automaticamente pelo fluxo /meta-cli-install (OAuth). Nao editar a mao.
META_ACCESS_TOKEN=
META_ACT_ID=
META_PIXEL_ID=

# Obsidian memory layer (optional)
# Filesystem path to the Obsidian vault used for long-term KPA memory.
KPA_OBSIDIAN_VAULT=
